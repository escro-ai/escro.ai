# Escro bot environment (example). Copy to .env and edit. NEVER commit .env.
#
# This kit NEVER accepts a pasted private key. Your wallet keypair is generated
# locally under ./wallet (gitignored, 0600); do not put key material here.
#
# Load these when you run the bot, e.g.: node --env-file=.env dist/src/bot.js

# Cluster the bot runs against (devnet | mainnet). Overrides escro.config.ts.
ESCRO_NETWORK=devnet

# Solana RPC endpoint (e.g. https://api.devnet.solana.com).
ESCRO_RPC_URL=

# Escro REST API base URL (e.g. https://api.escro.ai).
ESCRO_API_URL=
